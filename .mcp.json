{
  "mcpServers": {
    "aws-pricing-calculator": {
      "command": "npx",
      "args": ["-y", "sample-aws-pricing-calculator-mcp"]
    },
    "azure-pricing-mcp": {
      "command": "uvx",
      "args": [
        "--with",
        "mcp<2",
        "--from",
        "git+https://github.com/msftnadavbh/AzurePricingMCP",
        "azure-pricing-mcp"
      ]
    }
  }
}
